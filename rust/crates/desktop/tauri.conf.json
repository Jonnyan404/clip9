{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clip9",
  "version": "0.1.0",
  "identifier": "com.clip9.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "clip9",
        "width": 760,
        "height": 520,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: http: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Browser-based cloud clipboard",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "MacOS/clip9-server": "binaries/clip9-server"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/clip9-server": "binaries/clip9-server"
        }
      },
      "appimage": {
        "files": {
          "/usr/bin/clip9-server": "binaries/clip9-server"
        }
      }
    }
  }
}
