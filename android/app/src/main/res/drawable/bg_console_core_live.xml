<?xml version="1.0" encoding="utf-8"?>
<!-- 圆环中心那个圆 —— **运行中**（设计稿 `.ringwrap.live .core`）：墨绿底 + 绿边。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="270"
        android:endColor="@color/console_live_bottom"
        android:startColor="@color/console_live_top"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/console_ok_edge" />
</shape>
