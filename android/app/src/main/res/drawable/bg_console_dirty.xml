<?xml version="1.0" encoding="utf-8"?>
<!--
  底部那条「未生效的更改」横栏（设计稿 `.dirty`）：蓝灰底 + 更亮的蓝边。

  ⚠️ 它比周围的卡片**亮**是故意的：这条东西只有在真的有改动时才会冒出来，
  而它要回答的问题是「我改的东西算数吗」—— 底色比卡片暗的话，它就会沉进背景里，
  用户会带着「刚才那些改动到底存了没有」离开这一页。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="15dp" />
    <solid android:color="@color/console_dirty" />
    <stroke
        android:width="1dp"
        android:color="@color/console_dirty_edge" />
</shape>
