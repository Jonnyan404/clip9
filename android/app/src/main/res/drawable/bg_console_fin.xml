<?xml version="1.0" encoding="utf-8"?>
<!--
  配置页 `.frow` 右侧那个小输入框（设计稿 `.fin`）：比卡片底再深的「洞」+ 一圈细边。

  ⚠️ 稿子里它是 38px 高、mono 字、右对齐的一小块 —— 那些规格在
  `Widget.Clip9.CfgInput`（themes.xml）里，不在这里；这里只管形状。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="@color/console_fin_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/console_fin_edge" />
</shape>
