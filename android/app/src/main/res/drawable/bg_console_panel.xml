<?xml version="1.0" encoding="utf-8"?>
<!--
  连接页顶部那张大面板（设计稿 `.panel`）。

  ⚠️ 设计稿用的是 `radial-gradient(120% 110% at 50% 0%, …)`（顶部中心亮）。
  Android 的 `<gradient type="radial">` 要写死 `gradientRadius`，而这个面板的宽度
  是 match_parent —— 半径写死之后在不同屏幕上要么溢出要么缩成一小团。
  所以这里用**从上到下的纵向渐变**近似：观感上都是「顶亮底暗」，
  而它在任何宽度下都正确。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="270"
        android:centerColor="@color/console_surface"
        android:endColor="@color/console_panel_bottom"
        android:startColor="@color/console_panel_top"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/console_edge" />
</shape>
