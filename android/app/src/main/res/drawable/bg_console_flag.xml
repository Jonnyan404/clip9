<?xml version="1.0" encoding="utf-8"?>
<!--
  配置页卡头右侧那枚徽章的底（设计稿 `.cfg-h .flag`：`background:#2a2010` 橙字那副）。
  ⚠️ 绿色那副（`flag.ok`，`#122a20`）是 `bg_console_flag_ok.xml` —— 两个底色配两个 drawable，
  别用 backgroundTint 换色：tint 会把**描边一起**染掉，而这两个底色差得不是一点点。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="6dp" />
    <solid android:color="@color/console_flag_bg" />
</shape>
