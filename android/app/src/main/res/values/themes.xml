<?xml version="1.0" encoding="utf-8"?>
<!--
  主题。与父仓库的 Go 版 Android 工程同一套骨架（Material3 + DayNight + 无 ActionBar）。
  ⚠️ `Base.Theme.Clip9` 这一层是为了让 `values-night` 能只覆盖它需要覆盖的项，
  见同目录的 `values-night/themes.xml`。

  ⚠️ 这里**只定义主题与控制台在用的样式**：
  最开始写过两个（`TextAppearance.Clip9.Section` / `.Note`），但布局里用的是
  主题自带的 `?attr/textAppearanceTitleSmall` 那些 —— 那两个样式没有任何引用，删掉了。
  2026-09-30 配置页照稿子 ⑥⑦⑧ 重排（`cfg` 卡 + `frow` 行）之后，那套字号 / 颜色
  在二十来个字段上重复出现，才有了下面 `Text.Clip9.Cfg*` / `Widget.Clip9.CfgInput` 这一组 ——
  每一条都有布局里的引用者，别再往这里堆「以防万一」的样式。
-->
<resources>
    <style name="Base.Theme.Clip9" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.Clip9" parent="Base.Theme.Clip9" />

    <!--
      管理页（`MainActivity`）专用：**固定深色**的控制台。

      ⚠️★ 为什么不像 `Theme.Clip9` 那样跟系统亮暗走：设计稿 `b-console.html` 是一份
      **深色**控制台（屏底 `#0a111f`、卡片 `#111c2e`、面板从上到下由亮到暗）。
      要「与设计稿一致」就不能让它随系统漂移 —— 亮色主题下那份稿子根本无从对照。
      ⚠️ parent 选 `Theme.Material3.Dark`（不是 DayNight）：`Dark` 本身就恒定深色。
      ⚠️ `windowBackground` 必须显式设成控制台底色：不设的话窗口在布局加载出来之前
      会先闪一下主题默认的面色（在深色界面上是一个明显的白闪）。

      ⚠️ 只给 MainActivity 用。`WebAppActivity` 显示的是服务端下发的网页，它有自己的配色，
      套上深色控制台反而会让「网页还没加载出来」那一段底色不对。
    -->
    <style name="Theme.Clip9.Console" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/console_bg</item>
        <item name="android:statusBarColor">@color/console_bg</item>
        <item name="android:navigationBarColor">@color/console_bg</item>
        <item name="colorPrimary">@color/console_accent</item>
        <!--
          ⚠️★ 配置页那一大片的标题 / 正文用的是 `?attr/textAppearance*`（Material3 的
          语义色），落到默认的 `colorOnSurface` 上是**暖灰**（#E6E1E5 那一族）—— 而设计稿
          通篇是**冷蓝白**（#eaf0fa / #8296b3）。这就是「配置页颜色和稿子差一层」的来源，
          在这两个属性上盖掉，整页语义色就归到稿子那组冷色。
          ⚠️ 输入框的 hint 走 `android:textColorHint`，也一并归到 faint。
        -->
        <item name="colorOnSurface">@color/console_text</item>
        <item name="colorOnSurfaceVariant">@color/console_text_body</item>
        <item name="android:textColorHint">@color/console_text_faint</item>
    </style>

    <!--
      ── 控制台上的两个按钮样式 ──────────────────────────────────────────────

      ⚠️★ 两个都继承 `Widget.Material3.Button.TextButton`（**不是** OutlinedButton）：
      前者没有描边与内缩，才压得出设计稿那种「一块纯色圆角」的样子。
      继承 Outlined 的话 `MaterialButtonToggleGroup` 还会在三个页签之间补上一圈描边，
      而稿子里的分段控件是**没有分隔线**的（选中的那格自己亮起来）。

      ⚠️ `insetTop/insetBottom` 必须归零：Material 按钮默认上下各留 6dp 的隐形内缩
      （给阴影用），不归零的话控件比它看起来的高度多出 12dp，
      于是「圆环面板底下那条快捷栏」会比稿子里高出一截，而且量不出是为什么。
      ⚠️ `stateListAnimator` 归零：同理，要的是平面的一块色，不是会浮起来的按钮。
    -->
    <style name="Widget.Clip9.SegButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">10dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 迷你状态条上那个「启动 / 停止 / 请稍候」按钮（设计稿 `.strip .go`）。 -->
    <style name="Widget.Clip9.ConsoleButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">10dp</item>
        <item name="elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!--
      ── 配置页那一组（稿子 ⑥⑦⑧ 的 `.cfg` / `.frow`）────────────────────────
      字号与颜色逐条对照稿子的 CSS，值只引 colors.xml —— 稿子改色号时改那一份就够。

      ⚠️★ 布局里**不再**用 `?attr/textAppearance*`：那套落在 Material3 语义色上，
      颜色归 `colorOnSurface` 管 —— 主题里已经把它拨到 console_text，但**字号**那层
      （TitleMedium 16sp / TitleSmall 14sp / BodySmall 12sp）与稿子（卡头 12 / 行标题 14 /
      说明 11.5）对不上。照稿子重排之后全部走这一组写死的样式。
    -->
    <!-- 卡头标题（`.cfg-h b`）：小号大字距，是「分区名」不是「行标题」。 -->
    <style name="Text.Clip9.CfgHead" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/console_say</item>
    </style>

    <!-- 卡头右侧徽章的文字（`.cfg-h .flag`）。底色两副脸色见
         bg_console_flag（橙）/ bg_console_flag_ok（绿），由代码按状态换。 -->
    <style name="Text.Clip9.CfgFlag" parent="">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/console_flag_text</item>
    </style>

    <!-- 行标题（`.frow-t > b`）与行说明（`.frow-t span`）。 -->
    <style name="Text.Clip9.CfgTitle" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/console_text</item>
    </style>

    <style name="Text.Clip9.CfgHint" parent="">
        <item name="android:textSize">11.5sp</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
        <item name="android:textColor">@color/console_text_body</item>
    </style>

    <!--
      `.fin` 右侧小输入框：38dp 高、mono、写死一套配色（不跟 hint 走）。

      ⚠️★ parent 用**平台**的 `Widget.EditText` 而不是 `Widget.Material3.EditText`：
      后者是给 `TextInputLayout` 的FilledBox 体系预备的，直接套在裸 EditText 上
      会拖进一套背景与最小高度的假设 —— 而我们本来就要用自己的 `bg_console_fin`
      整个盖掉背景。
      ⚠️ 输入框**没有** `backgroundTint`：默认底会被 `android:background` 整个盖掉，
      这正是想要的（稿子的 fin 是一块圆角面板）。
    -->
    <style name="Widget.Clip9.CfgInput" parent="@android:style/Widget.EditText">
        <item name="android:minWidth">96dp</item>
        <item name="android:maxWidth">150dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/console_text</item>
        <item name="android:textColorHint">@color/console_text_faint</item>
        <item name="android:background">@drawable/bg_console_fin</item>
        <item name="android:imeOptions">actionDone</item>
    </style>
</resources>
