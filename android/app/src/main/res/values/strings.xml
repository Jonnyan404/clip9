    <string name="ssl_title">证书验证没通过</string>
    <string name="ssl_message">这个地址用了自签证书（或者证书链有问题）。\n\n%1$s\n\n指纹（SHA-256）：\n%2$s\n\n只在你确定那台服务端是自己的时候继续 —— 继续就等于放弃这次校验。</string>
    <string name="ssl_continue">仍然继续</string>
    <string name="ssl_cancel">取消</string>

