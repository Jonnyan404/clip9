<?xml version="1.0" encoding="utf-8"?>
<!--
  界面文案。
  ⚠️ 这里只有 Android **原生**那两页（管理页 + WebView 壳）的字。看板/分享页的文案在
  `web-vue3/src/locales/{zh,zh-TW,en,ja}.json`（那是**服务端下发**的，与这边无关，
  四份都要补的那条规则说的是那边）。

  ⚠️★ 写文案时记住这是**要显示在手机上的字**，不是注释：
  别写 `**加粗**` 这种 markdown（屏幕上会原样出现星号）、别为了对齐在字符串里排版
  （换行与缩进都会被原样保留），要换行就写 `\n`。
-->
<resources>
