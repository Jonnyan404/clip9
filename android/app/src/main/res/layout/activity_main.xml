<?xml version="1.0" encoding="utf-8"?>
<!--
  管理页（方案 B：顶部状态条 + 连接 / 配置 / 其它三页）。

  ⚠️★ 这一页**没有看板** —— 看板在 WebAppActivity 里由服务端下发。
  这一页管的是「服务端本身」：起停、地址、服务端配置、远端服务器清单。

  ⚠️★ 结构上只有三层，别加第四层：
    ① 最外是 LinearLayout（不是 ScrollView！）—— 因为「未生效的更改」那条横栏
       要**钉在屏幕底部**，而它在 ScrollView 里就会跟着内容一起滚走。
    ② 中间那个 ScrollView 包住**三页的全部内容**（用 visibility 切换），
       于是切页的时候滚动位置会重置 —— 这是**想要的**（用户切过去就是想看那一页的开头）。
    ③ 底部横栏平时 `gone`，只有在配置页改过东西时出现。

  ⚠️ 用 ScrollView + LinearLayout 而不是 ConstraintLayout：
  「一串卡片」在约束布局里只会多出一堆互相牵扯的约束，改一处要动三处。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <!-- ── 顶部状态条：三页共用，不随切页滚走 ────────────────────────
                 ⚠️ 它**不镜像状态**：每一轮都问 ServerBridge.status（Rust 那边是唯一权威）。
                 在这个条上显示的东西只有「真的监听着的那个地址」，所以它跟着服务端走。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?attr/colorSurfaceVariant"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- ⚠️ 用「●」而不是一张 drawable：省一个资源文件，而且它天然跟着字号走。
                     颜色由代码按状态设（见 MainActivity.refreshStrip）。 -->
                <TextView
                    android:id="@+id/stripLed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="@string/strip_led"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/stripState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/stripAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <Button
                    android:id="@+id/powerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="40dp" />
            </LinearLayout>

            <!-- 本地组件没加载成功（.so 不在 / ABI 不对）—— 平时不显示 -->
            <TextView
                android:id="@+id/libMissingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/error"
                android:visibility="gone" />

            <!-- 启动失败的原文（Rust 那边存着的 last_error，原样显示） -->
            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/error"
                android:visibility="gone" />

            <!-- ── 分段：连接 / 配置 / 其它 ────────────────────────────────── -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tabGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabConnect"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_connect" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabConfig"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_config" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabOther"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tab_other" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- ══════════════ ① 连接 ══════════════ -->
            <LinearLayout
                android:id="@+id/pageConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/section_local"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/addressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textIsSelectable="true" />

                <LinearLayout
                    android:id="@+id/addressActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/copyAddressButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/copy_address" />

                    <Button
                        android:id="@+id/openLocalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/open_local_ui" />
                </LinearLayout>

                <Button
                    android:id="@+id/qrButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/show_qr"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/show_qr"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <!-- 远端服务器清单 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/remote_section"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/remote_section_note"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <!-- ⚠️ 里面的行是**代码生成**的（数量不定）—— 见 MainActivity.renderRemoteServers -->
                <LinearLayout
                    android:id="@+id/remoteList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/remoteEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/remote_none"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <Button
                    android:id="@+id/remoteAddButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/remote_add" />
            </LinearLayout>

            <!-- ══════════════ ② 配置 ══════════════ -->
            <LinearLayout
                android:id="@+id/pageConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 读不出来 / 还没生成 的提示条 -->
                <TextView
                    android:id="@+id/configNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/error"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/configNotCreated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/config_not_created"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone" />

                <!-- ── 访问与安全 ── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/config_section_access"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/configAuthFlag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_global_password"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configGlobalPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_global_password"
                    android:imeOptions="actionDone"
                    android:inputType="textVisiblePassword" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_global_password_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:id="@+id/configRoomsTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/config_rooms"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/configRoomsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_rooms_none"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <!-- ⚠️ 行是代码生成的（房间数量不定）—— 见 ConfigPage.renderRooms -->
                <LinearLayout
                    android:id="@+id/configRoomList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/configAddRoomButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/config_room_add" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/config_room_list"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <Switch
                    android:id="@+id/configRoomListSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_room_list" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_room_list_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_room_cleanup"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configRoomCleanup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_room_cleanup"
                    android:imeOptions="actionDone"
                    android:inputType="numberSigned" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_room_cleanup_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <!-- ── 内容限制 ── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/config_section_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_history"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_history"
                    android:imeOptions="actionDone"
                    android:inputType="numberSigned" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_history_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_text_limit"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configTextLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_text_limit"
                    android:imeOptions="actionDone"
                    android:inputType="numberSigned" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_text_limit_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_file_limit"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configFileLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_file_limit"
                    android:imeOptions="actionDone"
                    android:inputType="numberSigned" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_file_limit_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_file_chunk"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configFileChunk"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_file_chunk"
                    android:imeOptions="actionDone"
                    android:inputType="numberSigned" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_file_chunk_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_file_expire"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configFileExpire"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_file_expire"
                    android:imeOptions="actionDone"
                    android:inputType="numberSigned" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_file_expire_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <!-- ── 定时自动化 ── -->
                <TextView
                    android:id="@+id/configAutomationTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/config_automation"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <Switch
                    android:id="@+id/configAutomationEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_automation_enabled" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_automation_enabled_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_tick_seconds"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configTickSeconds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_tick_seconds"
                    android:imeOptions="actionDone"
                    android:inputType="numberSigned" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_tick_seconds_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_grace_seconds"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configGraceSeconds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_grace_seconds"
                    android:imeOptions="actionDone"
                    android:inputType="numberSigned" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_grace_seconds_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_default_tz"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configDefaultTz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_default_tz"
                    android:imeOptions="actionDone"
                    android:inputType="text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_default_tz_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <!-- ── 网络与存储（危险区）── -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/config_section_network"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_section_network_note"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/error" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_host"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_host"
                    android:imeOptions="actionDone"
                    android:inputType="textUri" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_host_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_port"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_port"
                    android:imeOptions="actionDone"
                    android:inputType="number" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_port_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_prefix"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configPrefix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_prefix"
                    android:imeOptions="actionDone"
                    android:inputType="textUri" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_prefix_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_cert"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configCert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_cert"
                    android:imeOptions="actionDone"
                    android:inputType="textUri" />

                <EditText
                    android:id="@+id/configKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:autofillHints=""
                    android:hint="@string/config_key"
                    android:imeOptions="actionDone"
                    android:inputType="textUri" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_tls_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_db_path"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configDbPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_db_path"
                    android:imeOptions="actionDone"
                    android:inputType="textUri" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_db_path_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/config_storage_dir"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <EditText
                    android:id="@+id/configStorageDir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:hint="@string/config_storage_dir"
                    android:imeOptions="actionDone"
                    android:inputType="textUri" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_storage_dir_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:id="@+id/configDataDir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textIsSelectable="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_data_dir_note"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>

            <!-- ══════════════ ③ 其它 ══════════════ -->
            <LinearLayout
                android:id="@+id/pageOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/section_other"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <Button
                    android:id="@+id/batteryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/battery_whitelist" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_note"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <Button
                    android:id="@+id/webViewCheckButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/webview_check" />

                <TextView
                    android:id="@+id/webViewVersionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/dataDirText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/other_server_note"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ── 底部：未生效的更改 ──────────────────────────────────────────────
         ⚠️★ 它**只在配置文件被改过**的时候出现，而且**必须先保存再重启**
         才真的生效（服务端只在启动时读一次配置）—— 所以按钮写的是
         「保存并重启」，不是「保存」。写成后者会让人以为保存完就生效了。
         ⚠️ 它在 ScrollView **外面**，所以是钉在屏幕底部的。 -->
    <LinearLayout
        android:id="@+id/dirtyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/dirtyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <Button
            android:id="@+id/dirtyDiscard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/dirty_discard" />

        <Button
            android:id="@+id/dirtySave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/dirty_save" />
    </LinearLayout>
</LinearLayout>
