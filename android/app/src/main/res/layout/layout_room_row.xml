<?xml version="1.0" encoding="utf-8"?>
<!--
  一个房间的编辑块（配置页里 `roomAuth` 的一项）。稿子 ⑥ 的 `.room` + `.redit`。

  ⚠️★ 它是**被代码 inflate 多次**的（房间有几个就几份），所以：
  - 这里面的 id 会在每一份里重复出现 —— 这没问题，因为绑定用的是
    `row.findViewById(...)`（在那**一份**视图树里找），不是 Activity 级的 `findViewById`。
  - 千万不要在 Activity 里直接 `findViewById(R.id.roomName)`：那只会拿到第一份。
  - 所以这个布局里**不许**出现与 `activity_main.xml` 重名的 id，也不要在这里用 `@+id`
    去引用 Activity 里的东西。

  ⚠️ 顶行是「房间名 + 标签 + 展开」（收起来的时候一屏能看下好几个房间），
  展开之后才是四个字段 —— 房间多的时候全展开会让人找不到北。
  ⚠️ 底色用 `console_fin_bg`（稿子 `.redit` 的 `#0c1524`）：
  它比卡片底再深一档，「收着的房间行 / 展开的编辑区」层次才分得开。
  样式沿用配置页那组 `Text.Clip9.Cfg*` / `Widget.Clip9.CfgInput`。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_console_fin"
        android:gravity="center_vertical"
        android:minHeight="54dp"
        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/roomHeadName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/console_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/roomHeadFlag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_console_flag"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            style="@style/Text.Clip9.CfgFlag" />

        <Button
            android:id="@+id/roomExpand"
            style="@style/Widget.Clip9.ConsoleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="32dp"
            android:text="@string/config_room_expand"
            android:textColor="@color/console_text_mid"
            app:backgroundTint="@color/console_edge" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/roomBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/console_fin_bg"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="13dp"
        android:paddingEnd="15dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_room_name_label"
            style="@style/Text.Clip9.CfgTitle" />

        <EditText
            android:id="@+id/roomName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autofillHints=""
            android:hint="@string/config_room_name_hint"
            android:inputType="text"
            android:maxLines="1"
            style="@style/Widget.Clip9.CfgInput" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/config_room_password_label"
            style="@style/Text.Clip9.CfgTitle" />

        <EditText
            android:id="@+id/roomPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autofillHints=""
            android:hint="@string/config_room_password_label"
            android:inputType="textVisiblePassword"
            android:maxLines="1"
            style="@style/Widget.Clip9.CfgInput" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_room_open_label"
                    style="@style/Text.Clip9.CfgTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/config_room_open_hint"
                    style="@style/Text.Clip9.CfgHint" />
            </LinearLayout>

            <Switch
                android:id="@+id/roomOpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/config_room_expire_label"
            style="@style/Text.Clip9.CfgTitle" />

        <EditText
            android:id="@+id/roomExpire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:autofillHints=""
            android:hint="@string/config_room_expire_label"
            android:inputType="numberSigned"
            android:maxLines="1"
            style="@style/Widget.Clip9.CfgInput" />

        <TextView
            android:id="@+id/roomExpireHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            style="@style/Text.Clip9.CfgHint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/config_room_automation_label"
            style="@style/Text.Clip9.CfgTitle" />

        <RadioGroup
            android:id="@+id/roomAutomation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/roomAutoFollow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/automation_follow"
                android:textColor="@color/console_text_mid"
                android:textSize="12.5sp" />

            <RadioButton
                android:id="@+id/roomAutoNone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/automation_none"
                android:textColor="@color/console_text_mid"
                android:textSize="12.5sp" />

            <RadioButton
                android:id="@+id/roomAutoSingle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/automation_single"
                android:textColor="@color/console_text_mid"
                android:textSize="12.5sp" />

            <RadioButton
                android:id="@+id/roomAutoRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/automation_room"
                android:textColor="@color/console_text_mid"
                android:textSize="12.5sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/automation_hint"
            style="@style/Text.Clip9.CfgHint" />

        <Button
            android:id="@+id/roomRemove"
            style="@style/Widget.Clip9.ConsoleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/config_room_remove"
            android:textColor="@color/console_err_text"
            app:backgroundTint="@color/console_go_stop" />
    </LinearLayout>
</LinearLayout>
