<?xml version="1.0" encoding="utf-8"?>
<!--
  编辑一台远端服务端的对话框。

  ⚠️ 用 ScrollView 包住：键盘弹起来之后对话框剩下的高度很小，
  不滚的话下面那几个开关和按钮就够不着了（用户会以为对话框没做完）。

  ⚠️ 这里的 id 全是**这一份**的（对话框每次新建一个），所以不存在
  「同一棵树里重复」的问题 —— 但仍然不要和 activity_main / 那几个行布局重名，
  免得以后有人把它们挪到一起时踩坑。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_name"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <EditText
            android:id="@+id/editorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/remote_name_hint"
            android:imeOptions="actionNext"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/remote_url"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <EditText
            android:id="@+id/editorUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/remote_url_hint"
            android:imeOptions="actionNext"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_url_note"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/remote_room"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <EditText
            android:id="@+id/editorRoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/remote_room_hint"
            android:imeOptions="actionNext"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_room_note"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/remote_password"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <EditText
            android:id="@+id/editorPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/remote_password_hint"
            android:imeOptions="actionDone"
            android:inputType="textVisiblePassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_password_note"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <Switch
            android:id="@+id/editorRemember"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/remote_remember" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_remember_note"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <Switch
            android:id="@+id/editorAutoAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/remote_auto_auth" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remote_auto_auth_note"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <Button
            android:id="@+id/editorTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/remote_test" />

        <TextView
            android:id="@+id/editorTestResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textIsSelectable="true"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
