<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      ⚠️ 电池优化白名单要它（设计稿 §3.3）。⚠️ 这个权限在 Google Play 上是受限的
      （要申报理由），而这个 App 本来就不走 Play —— 换发布方式时要记得这件事。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clip9">
        <!--
          ⚠️ `allowBackup="false"`：数据目录里是服务端的库与上传的文件（可能很大），
          把它塞进云备份没有意义；而 `true` 在 targetSdk 31+ 上还要再配
          `dataExtractionRules` / `fullBackupContent`，那是纯粹多出来的东西。
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Clip9.Console">
            <!-- ⚠️★ singleTask 而不是 singleTop：两个入口都靠 onNewIntent，而
                 singleTop 只在「我就在栈顶」时才复用 —— WebView（WebAppActivity）
                 开着的时候它压在下面，分享 Intent 会被系统投给**栈顶那个**
                 （WebAppActivity 不认 SEND，直接吞掉，连 onNewIntent 都轮不到
                 MainActivity）。2026-09-30 真机抓到：WebView 开着时分享，
                 handleShareIntent 一次都没被调。singleTask 的语义是「Intent 路由
                 给任务里那个既有实例」，不管它上面压着谁 —— 通知点回来同样
                 不会再叠管理页（原来 singleTop 承担的那个职责）。
                 ⚠️ 代价：投递会再开一个 WebAppActivity 叠在旧的上面，
                 返回时要按两下才回到最初的页面 —— 比静默丢分享好。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              「分享 → clip9」。
              ⚠️★ 这里**只声明 `text/plain`**：文件那条路还没做（见 `SharePayload.kt` 抬头）。
              声明了 `image/*` 就会让用户在相册的分享面板里看到 clip9，点进来却只能得到
              一句「还没做」—— 那比「分享面板里没有 clip9」更糟。
              ⚠️ 分享的入口放在**管理页**而不是 WebView 页：冷启动时服务端还没起来，
              得先把服务端起起来（MainActivity 的 `handleShareIntent`），
              而 `WebAppActivity` 需要有人给它一个地址才能开。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WebAppActivity"
            android:exported="false" />

        <service
            android:name=".ServerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
